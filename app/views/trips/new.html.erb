<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 pro-card">
      <h1 class="text-center mb-4">Plan your trip</h1>
      <div class="p-4">
        <%= simple_form_for @trip do |f| %>
          <%= f.input :date, html5: true %>
          <%= f.input :place_name,
              collection: Place.order(:name).pluck(:name),
              input_html: {
                data: { controller: "tom-select" }
              } %>

          <%= f.input :experience,
                as: :radio_buttons,
                collection: ["Beginner", "Intermediate", "I'm pro bro"],
                label: "Experience level",
                wrapper: :vertical_collection_inline %>

          <%= f.input :fishing_style,
                as: :radio_buttons,
                collection: ["From the shore", "With a boat"],
                label: "How will you fish?",
                wrapper: :vertical_collection_inline %>

          <%= f.input :catch_policy,
                as: :radio_buttons,
                collection: ["Keep", "Release"],
                label: "Keep or release?",
                wrapper: :vertical_collection_inline %>

          <div class="flex-box">
            <div class="button">
              <%= f.submit "Plan my trip",
                  class: "button_top",
                  data: { turbo_submits_with: "Planning your trip…" } %>
            </div>
          </div>

        <% end %>
      </div>
    </div>
  </div>
</div>
