<h1 class="text-center"><%= @trip.place.name %></h1>
<p class="text-muted text-center"><%= @trip.date %></p>
<div class="px-3 pb-3">
  <div class="row">
    <div id="trip" class="col-6">
      <div class="card p-4">
        <%= markdown(@trip.plan) %>
      </div>
    </div>
    <div class="col-6">
      <div id="map" style="height: 80vh;"
        data-controller="google-maps"
        data-google-maps-markers-value="<%= @markers.to_json %>"
        >
      </div>
    </div>
  </div>
</div>

<div id="messages" class="">

</div>

<%= javascript_include_tag "https://maps.googleapis.com/maps/api/js?libraries=places&key=#{ENV['GOOGLE_API_BROWSER_KEY']}" %>
