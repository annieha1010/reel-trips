<div class="row">
  <div id="trip" class="col-6 container my-5">
    <h1><%= @trip.place.name %></h1>
    <p class="text-muted"><%= @trip.date %></p>
    <div class="card p-4">
      <%= markdown(@trip.plan) %>
    </div>
    <%= render "trips/new_plan_form", trip: @trip %>
    <%= link_to "Back to my trips", trips_path, class: "btn btn-outline-primary mt-3" %>
  </div>
  <div id="map" class="col-6">
  </div>
</div>
<div id="chat" class="">
  <div class="messages">
    <div id="messages">
      <% @messages.each do |message| %>
        <%= render "messages/message", message: message %>
      <% end %>
    </div>
    <div class="message-form">
      <%= render "messages/form" %>
    </div>
  </div>
</div>
