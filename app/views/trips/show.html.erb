<div class="row">
  <div id="trip" class="col-6 container my-5">
    <h1><%= @trip.place.name %></h1>
    <p class="text-muted"><%= @trip.date %></p>

    <div class="card p-4">
      <%= markdown(@trip.plan) %>
    </div>

    <%= link_to "Back to my trips", trips_path, class: "btn btn-outline-primary mt-3" %>
  </div>

  <div id="map" class="col-6">

  </div>
</div>
<div id="chat" class="">
  <div class="messages">
  </div>
  <div class="message-form">
    <%= render "messages/form" %>
  </div>
</div>
