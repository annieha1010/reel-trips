<h1 class="text-center"><%= @trip.place.name %></h1>
<p class="text-muted text-center"><%= @trip.date %></p>
<div class="px-3 pb-3">
  <div class="row g-3">
    <div id="trip" class="col-12 col-md-6 order-2 order-md-1">
      <div class="card p-4">
        <%= markdown(@trip.plan) %>
      </div>
    </div>
    <div class="col-12 col-md-6 order-1 order-md-2">
      <div id="map" class="trip-map"
        data-controller="google-maps"
        data-google-maps-markers-value="<%= @markers.to_json %>"
        >
      </div>
    </div>
  </div>
</div>
<div class="chat-panel" data-controller="chat-panel">
  <button type="button" class="chat-panel-bar" data-action="click->chat-panel#toggle">
    Make a change or ask a question
  </button>
  <div class="chat-panel-body">
    <div id="chat">
      <div id="messages">
        <% @messages.each do |message| %>
          <%= render "messages/message", message: message %>
        <% end %>
      </div>
      <div id="new_message_container" class="message-form">
        <%= render "messages/form", trip: @trip, message: @message %>
      </div>
    </div>
  </div>
</div>
<%= javascript_include_tag "https://maps.googleapis.com/maps/api/js?libraries=places&key=#{ENV['GOOGLE_API_BROWSER_KEY']}" %>
