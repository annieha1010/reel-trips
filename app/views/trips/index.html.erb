<div class="container">
  <div class="header">
    <h1>Trips</h1>
    <%= simple_form_for :search, url: trips_path, method: :get do |f| %>
      <%= f.input :query, as: :string, label: false, input_html: { value: params.dig(:search, :query), placeholder: "Search places..." } %>
      <%= f.submit "Search", class: "btn btn-primary mb-3" %>
    <% end %>
  </div>
  <div class="cards">
    <% @trips.each do |trip| %>
      <div class="card-trip">
        <%= image_tag (trip.image_url.presence || "no_photo.png"), alt: "trip.place.name", class: "card-img-top" %>
        <div class="card-trip-infos" >
          <% status = trip_status_badge(trip) %>
          <% if status %>
            <span class="trip-status-badge">
              <%= status %>
            </span>
          <% end %>
          <div>
            <h2><%= trip.place.name %></h2>
            <p><%= trip.date %></p>
          </div>
          <%= image_tag trip.season_image, alt: "text" , class: "season-image"%>
        </div>
        <%= link_to "", trip_path(trip), class: "position-absolute top-0 bottom-0 w-100" %>
        <%= link_to trip_path(trip),data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}, class: "position-absolute top-0 end-0 p-3 text-secondary" do %>
          <i class="fa-regular fa-trash-can text-white"></i>
        <% end %>
      </div>
    <% end %>
    <%= @image %>
  </div>
</div>
