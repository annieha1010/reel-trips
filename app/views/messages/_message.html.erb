<% if message.role == "user" %>
  <div class="d-flex justify-content-end mb-2">
    <div class="bg-light px-3 pt-3 pb-1 rounded">
      <%= markdown(message.content) %>
    </div>
  </div>
<% else %>
  <div class="d-flex justify-content-start mb-3">
    <div class="px-3 pt-3 pb-1">
      <%= markdown(message.content) %>
    </div>
  </div>
<% end %>
